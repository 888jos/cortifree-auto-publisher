{
  "name": "cortifree-auto-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:export-supabase": "tsx scripts/export-cortifree-supabase.ts",
    "convex:migrate-files": "tsx scripts/migrate-files-to-convex.ts",
    "doctor": "tsx src/cli/index.ts doctor",
    "assets:scan": "tsx src/cli/index.ts assets:scan",
    "assets:retag-stock": "node --env-file=.env.local --import tsx scripts/retag-stock-assets.ts",
    "personas:validate": "tsx src/cli/index.ts personas:validate",
    "personas:bootstrap": "tsx scripts/bootstrap-persona-config.ts",
    "personas:sync": "tsx scripts/sync-persona-image-assets.ts",
    "refs:scan": "tsx src/cli/index.ts refs:scan",
    "refs:analyze": "tsx src/cli/index.ts refs:analyze",
    "refs:bootstrap": "tsx scripts/bootstrap-visual-references.ts",
    "refs:import-pinterest": "tsx scripts/import-pinterest-references.ts",
    "carousel:create": "tsx src/cli/index.ts carousel:create",
    "carousel:render": "tsx src/cli/index.ts carousel:render",
    "carousel:approve": "tsx src/cli/index.ts carousel:approve",
    "publish:dry": "tsx src/cli/index.ts publish:dry",
    "jobs:failures": "tsx src/cli/index.ts jobs:failures",
    "scheduler:run": "tsx src/cli/index.ts scheduler:run",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "editorial:bootstrap": "tsx scripts/bootstrap-editorial-config.ts",
    "autonomy:check": "tsx src/cli/index.ts scheduler:run",
    "google:sync": "node --env-file=.env.local --import tsx scripts/sync-google-to-convex.ts",
    "p0:bootstrap-data": "tsx scripts/p0-bootstrap-data.ts",
    "p0:check": "tsx scripts/p0-runtime-check.ts",
    "acceptance:20": "tsx scripts/acceptance-20.ts",
    "acceptance:record": "tsx scripts/acceptance-record.ts",
    "production:check": "tsx scripts/production-gate-check.ts",
    "secrets:generate": "tsx scripts/generate-cortifree-secrets.ts",
    "google:sync:personas": "npm run google:sync -- --scope=assets --limit=250",
    "google:sync:stock-missing": "npm run google:sync -- --scope=stock_missing --limit=50",
    "google:sync:stock-state": "npm run google:sync -- --scope=stock --limit=250",
    "google:sync:refs-state": "npm run google:sync -- --scope=visual_refs --limit=250",
    "google:sync:persona": "npm run google:sync -- --scope=assets --limit=250",
    "worker:start": "node --import tsx src/worker/heavy-worker.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "convex": "^1.45.0",
    "next": "15.5.25",
    "openai": "^7.10.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.4",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "19.2.18",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  }
}
