NODE_ENV=development
DRIVE_ROOT=/path/to/GoogleDrive/CORTIFREE_CONTENT
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5.6-luna
OPENAI_MODEL_QA=gpt-5.6-terra
AI_GENERATION_ENABLED=true
OPENAI_QA_ENABLED=true
OPENAI_QA_SAMPLE_RATE=0.20
OPENAI_MAX_MONTHLY_USD=15
OPENAI_TIMEOUT_MS=45000
MODELARK_API_KEY=
MODELARK_MODEL_ID=
UPLOAD_POST_API_KEY=
# Comma-separated Upload-Post usernames owned by CortiFree. Empty means no publishing profile.
CORTIFREE_UPLOAD_POST_PROFILES=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DRY_RUN=true
REQUIRE_APPROVAL=true
NEXT_PUBLIC_COCORISE_URL=https://cocorise-auto-publisher-vid-os-coco.vercel.app
AI_DISCLOSURE_MODE=auto
TARGET_READY_BUFFER_DAYS=3
MAX_TEXT_RETRIES=3
MAX_IMAGE_RETRIES=3
MAX_RENDER_RETRIES=2
