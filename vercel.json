{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "crons": [
    {
      "path": "/api/sync/google",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/autonomy/run",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/autonomy/run",
      "schedule": "0 9 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
