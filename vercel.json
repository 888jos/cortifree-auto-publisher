{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/sync/google",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/autonomy/run",
      "schedule": "0 8,9 * * *"
    }
  ],
  "ignoreCommand": "node scripts/vercel-ignore.mjs"
}
